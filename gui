import tkinter, tkinter.messagebox
class MyGUI:
  def __init__(self):
    self.main_window = tkinter.Tk()
    #the entry 
    self.entry = tkinter.Entry(self.main_window, width=20)

    self.entry.pack()
    #the output label
    self.value = tkinter.StringVar()
    self.output_label_here = tkinter.Label(self.main_window, textvariable = self.value)
    self.output_label_here.pack()
    self.listbox = tkinter.Listbox(self.main_window, height = 5, width = 15)
    self.listbox.pack()
    fruits = ['Banna', 'Mango', 'Plums', 'Cherrys', 'Broccoil']
    for thing in fruits:
      self.listbox.insert(tkinter.END, thing)
    
